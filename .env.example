# LLM provider configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=300
HF_MODEL=Qwen/Qwen3-32B
# Set your Hugging Face token locally or through a secret manager.
HF_API_KEY=

# Hybrid retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
TOP_K_RESULTS=5

# Skeleton data paths
SKELETON_DIR=data/files_as_nodes
PDF_DIR=data/pdf
ENRICHED_NODES_DIR=data/enriched_nodes
OUTLINE_PATH=data/outline.json
