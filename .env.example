# Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=400
OLLAMA_LIST_NUM_PREDICT=900

# Document Configuration
PDF_PATH=data/pdf/Human Resources Policies & Procedures Manual (ML-HR-01, V.01).docx.pdf
CHROMA_DB_PATH=chroma_storage

# Embeddings Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Retrieval Configuration
TOP_K_RESULTS=8
BM25_ENABLE=true

# Generation — specific/focused questions (keep small for speed)
LLM_MAX_CHUNKS=3
LLM_MAX_CHARS_PER_CHUNK=1000

# Generation — list/overview questions (full points, no truncation)
LLM_LIST_MAX_CHUNKS=6
LLM_LIST_MAX_CHARS=6000

# Optional cloud inference (future): set OLLAMA_HOST to a remote OpenAI-compatible API
# e.g. Groq/OpenRouter — faster than local CPU, no change to app code needed

# Application
DEBUG=false
